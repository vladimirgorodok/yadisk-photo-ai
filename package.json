{
  "name": "yadisk-photo-ai",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --base=/",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build:android && npx cap sync android",
    "cap:open": "npx cap open android",
    "test:db": "tsc src/lib/db.ts --ignoreConfig --outDir scripts/.tmp --module esnext --moduleResolution bundler --target es2022 --lib dom,dom.iterable,es2022 --skipLibCheck && node scripts/db-test.mjs fresh && node scripts/db-test.mjs heal"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@huggingface/transformers": "^4.3.2",
    "@vladmandic/face-api": "^1.7.15",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
